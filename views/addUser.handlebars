{{!-- TEMPLATE FOR ADDING A NEW USER --}}
<br>
<div class="container-fluid">
    <p class="lead">Add New User</p>
    <div class="col-md-6">
        <form id="addUserForm">
            <div class="input-group input-group-sm mb-3">
                <span class="input-group-text">Username</span>
                <input id="newUserUsername" type="text" class="form-control" autocomplete="off">
            </div>
            <div class="input-group input-group-sm mb-3">
                <span class="input-group-text">Password</span>
                <input id="newUserPassword" type="password" class="form-control" autocomplete="new-password">
            </div>
            <div class="input-group input-group-sm mb-3">
                <span class="input-group-text">Confirm Password</span>
                <input id="newUserConfirmPassword" type="password" class="form-control" autocomplete="new-password">
            </div>
            <button type="submit" class="btn btn-primary">Create User</button>
        </form>
    </div>
</div>